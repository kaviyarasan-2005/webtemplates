<svg xmlns="http://www.w3.org/2000/svg" width="400" height="500" viewBox="0 0 400 500">
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#4A3025" stroke-width="0.4" opacity="0.08"/>
    </pattern>
  </defs>
  <rect width="400" height="500" fill="#8FAF88"/>
  <rect width="400" height="500" fill="url(#grid)"/>
  <rect x="20" y="25" width="360" height="450" fill="none" stroke="#B86F52" stroke-width="1.5" rx="4" opacity="0.3"/>
  <circle cx="200" cy="190" r="32" fill="#B86F52" opacity="0.25"/>
  <text x="200" y="202" text-anchor="middle" font-family="Georgia, serif" font-size="13" fill="#B86F52" font-weight="bold">RV</text>
  <text x="200" y="280" text-anchor="middle" font-family="Georgia, serif" font-size="13" fill="#4A3025" font-weight="bold">Anitha Krishnan</text>
  
  <text x="200" y="440" text-anchor="middle" font-family="sans-serif" font-size="8" fill="#4A3025" opacity="0.35">Image placeholder — ReVox Upholstery</text>
</svg>